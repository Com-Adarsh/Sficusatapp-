NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key. Never prefix with NEXT_PUBLIC_ and never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Convex client URL from the Convex production deployment
NEXT_PUBLIC_CONVEX_URL=

# Supabase Auth issuer: https://<project-ref>.supabase.co/auth/v1
# This must exactly match the iss claim in Supabase JWTs.
SUPABASE_AUTH_ISSUER=

# One-time secret used by convex/setup:initialize to grant the first super_admin.
PLATFORM_BOOTSTRAP_SECRET=
\n# Public coordinator contact values. Leave blank until confirmed; UI shows a neutral message when absent.\nNEXT_PUBLIC_AASHRAYA_COORDINATOR_CONTACT=\nNEXT_PUBLIC_SAHAYI_COORDINATOR_CONTACT=\n